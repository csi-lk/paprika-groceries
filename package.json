{
  "name": "paprika-groceries",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Read-only Paprika grocery list with one-tap Woolworths searches.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/csi-lk/paprika-groceries.git"
  },
  "homepage": "https://csi-lk.github.io/paprika-groceries/",
  "keywords": [
    "paprika",
    "groceries",
    "woolworths",
    "bun",
    "self-hosted",
    "github-pages"
  ],
  "engines": {
    "bun": ">=1.4"
  },
  "scripts": {
    "start": "bun src/server.ts",
    "dev": "bun --watch src/server.ts",
    "build:static": "bun scripts/build-static.ts",
    "build:static:live": "bun scripts/build-static.ts --live",
    "test": "bun test",
    "check": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "typescript": "^5.9.0"
